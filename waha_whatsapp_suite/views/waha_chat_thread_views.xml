<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_waha_chat_thread_list" model="ir.ui.view">
        <field name="name">waha.whatsapp.chat.thread.list</field>
        <field name="model">waha.whatsapp.chat.thread</field>
        <field name="arch" type="xml">
            <list string="Conversations" decoration-bf="unread_count &gt; 0">
                <field name="name" string="Contact"/>
                <field name="session_id"/>
                <field name="last_message" string="Last Message"/>
                <field name="last_message_date"/>
                <field name="unread_count"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="stage" widget="badge"
                       decoration-info="stage=='open'" decoration-warning="stage=='pending'"
                       decoration-success="stage=='resolved'"/>
                <button name="action_open_chat" type="object" string="Open" icon="fa-whatsapp" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_waha_chat_thread_kanban" model="ir.ui.view">
        <field name="name">waha.whatsapp.chat.thread.kanban</field>
        <field name="model">waha.whatsapp.chat.thread</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_small_column">
                <field name="unread_count"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="name"/></strong>
                                <span t-if="record.unread_count.raw_value &gt; 0"
                                      class="badge text-bg-success float-end">
                                    <field name="unread_count"/>
                                </span>
                            </div>
                            <div class="text-muted"><field name="last_message"/></div>
                            <div class="o_kanban_record_bottom">
                                <field name="last_message_date" widget="relative"/>
                                <field name="user_id" widget="many2one_avatar_user"/>
                            </div>
                            <div class="mt-1">
                                <button name="action_open_chat" type="object"
                                        class="btn btn-sm btn-primary">
                                    <i class="fa fa-whatsapp"/> Open
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_waha_chat_thread_form" model="ir.ui.view">
        <field name="name">waha.whatsapp.chat.thread.form</field>
        <field name="model">waha.whatsapp.chat.thread</field>
        <field name="arch" type="xml">
            <form string="Conversation">
                <header>
                    <button name="action_open_chat" type="object" string="Open Chat"
                            class="btn-primary" icon="fa-whatsapp"/>
                    <button name="action_assign_to_me" type="object" string="Assign to me"/>
                    <button name="action_mark_resolved" type="object" string="Mark Resolved"
                            invisible="stage == 'resolved'"/>
                    <button name="action_mark_open" type="object" string="Reopen"
                            invisible="stage != 'resolved'"/>
                    <field name="stage" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="unread_count"/>
                            <field name="last_message_date"/>
                        </group>
                    </group>
                    <group string="Last Message">
                        <field name="last_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waha_chat_thread_search" model="ir.ui.view">
        <field name="name">waha.whatsapp.chat.thread.search</field>
        <field name="model">waha.whatsapp.chat.thread</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Contact"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <filter string="Unread" name="unread" domain="[('unread_count','&gt;',0)]"/>
                <filter string="Assigned to me" name="mine" domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('stage','=','open')]"/>
                <filter string="Pending" name="pending" domain="[('stage','=','pending')]"/>
                <filter string="Resolved" name="resolved" domain="[('stage','=','resolved')]"/>
                <group name="group_by">
                    <filter string="Status" name="group_stage" context="{'group_by': 'stage'}"/>
                    <filter string="Assigned To" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_waha_chat_thread" model="ir.actions.act_window">
        <field name="name">Inbox</field>
        <field name="res_model">waha.whatsapp.chat.thread</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No conversations yet</p>
            <p>Incoming WhatsApp chats appear here so your team can assign and resolve them.</p>
        </field>
    </record>

</odoo>
