<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- WAHA Session List View -->
    <record id="view_waha_session_list" model="ir.ui.view">
        <field name="name">waha.whatsapp.session.list</field>
        <field name="model">waha.whatsapp.session</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Sessions" decoration-success="status=='working'"
                  decoration-warning="status=='scan_qr_code'" decoration-danger="status=='failed'">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="profile_name"/>
                <field name="status"/>
                <field name="engine"/>
                <field name="messages_sent"/>
                <field name="messages_received"/>
                <field name="last_sync"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- WAHA Session Form View -->
    <record id="view_waha_session_form" model="ir.ui.view">
        <field name="name">waha.whatsapp.session.form</field>
        <field name="model">waha.whatsapp.session</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Session">
                <header>
                    <button name="action_start_session" type="object" string="Start Session"
                            class="btn-primary" invisible="status in ['starting', 'working']"/>
                    <button name="action_stop_session" type="object" string="Stop Session"
                            class="btn-secondary" invisible="status in ['stopped', 'failed']"/>
                    <button name="action_refresh_status" type="object" string="Refresh Status"
                            class="btn-light"/>
                    <button name="action_open_sync_wizard" type="object" string="Sync from Phone"
                            class="btn-secondary" icon="fa-download"
                            invisible="status != 'working'"/>
                    <field name="status" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sent_messages" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="messages_sent" widget="statinfo" string="Sent"/>
                        </button>
                        <button name="action_view_received_messages" type="object" class="oe_stat_button" icon="fa-envelope">
                            <field name="messages_received" widget="statinfo" string="Received"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Inactive" bg_color="bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Session Name"/>
                        </h1>
                    </div>

                    <group>
                        <group name="session_config">
                            <field name="session_id"/>
                            <field name="waha_server_url"/>
                            <field name="api_key" password="True"/>
                            <field name="engine"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="profile_info">
                            <field name="phone_number"/>
                            <field name="profile_name"/>
                            <field name="last_sync"/>
                            <field name="last_sync_contacts"/>
                            <field name="last_sync_messages"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="QR Code" invisible="status not in ['scan_qr_code', 'starting']">
                            <div class="alert alert-info" role="alert">
                                <strong>Scan the QR Code with your WhatsApp mobile app</strong>
                                <br/>
                                Open WhatsApp → Settings → Linked Devices → Link a Device, then scan
                                the code shown below. It updates automatically until the session connects.
                            </div>

                            <field name="qr_code_image" widget="waha_qr_code" nolabel="1"/>

                            <div class="text-center mt-3">
                                <button name="action_get_qr_code" type="object" string="Reload QR Code"
                                        class="btn-secondary" icon="fa-refresh"/>
                            </div>
                        </page>

                        <page string="Webhook Configuration">
                            <group>
                                <group>
                                    <field name="webhook_url"
                                           placeholder="http://your-server.com/waha/whatsapp/webhook"
                                           readonly="0"/>
                                    <field name="webhook_events"
                                           placeholder="message,message.status,session.status"/>
                                </group>
                                <group>
                                    <button name="action_set_default_webhook"
                                            type="object"
                                            string="Set Default URL"
                                            class="btn-info"
                                            icon="fa-link"/>
                                    <button name="action_auto_configure_webhook"
                                            type="object"
                                            string="Auto Configure"
                                            class="btn-success"
                                            icon="fa-magic"/>
                                </group>
                            </group>

                            <div class="mt-3">
                                <button name="action_update_webhook"
                                        type="object"
                                        string="Update Webhook"
                                        class="btn-primary mr-2"
                                        invisible="status not in ['working', 'scan_qr_code']"/>
                            </div>

                            <div class="alert alert-info mt-3" role="alert">
                                <strong>Webhook Configuration:</strong>
                                <br/>
                                •
                                <strong>Default URL:</strong>
                                <code>
                                    <field name="webhook_url" readonly="1" nolabel="1"/>
                                </code>
                                <br/>
                                • <strong>Supported Events:</strong> message, message.status, session.status,
                                connection.update
                                <br/>
                                • <strong>Auto Configure:</strong> Sets default URL and events automatically
                            </div>

                            <div class="alert alert-warning mt-2" role="alert">
                                <strong>Note:</strong>
                                Make sure your Odoo server is accessible from the internet for webhooks to work.
                                The webhook URL is automatically generated based on your Odoo base URL.
                            </div>
                        </page>

                        <page string="Notifications">
                            <group>
                                <field name="notify_user_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Error Info" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>

                        <page string="Profile Picture" invisible="not profile_picture">
                            <field name="profile_picture" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WAHA Session Kanban View -->
    <record id="view_waha_session_kanban" model="ir.ui.view">
        <field name="name">waha.whatsapp.session.kanban</field>
        <field name="model">waha.whatsapp.session</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="status"/>
                <field name="phone_number"/>
                <field name="profile_name"/>
                <field name="messages_sent"/>
                <field name="messages_received"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="phone_number"/>
                                    </div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <span t-attf-class="badge badge-pill #{record.status.raw_value == 'working' ? 'badge-success' : record.status.raw_value == 'scan_qr_code' ? 'badge-warning' : 'badge-secondary'}">
                                        <field name="status"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="profile_name"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge badge-light">↗
                                        <field name="messages_sent"/>
                                    </span>
                                    <span class="badge badge-light">↙
                                        <field name="messages_received"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_waha_session" model="ir.actions.act_window">
        <field name="name">WhatsApp Sessions</field>
        <field name="res_model">waha.whatsapp.session</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first WhatsApp session
            </p>
            <p>
                WhatsApp sessions allow you to connect and manage multiple WhatsApp accounts.
                Click the create button to add a new session.
            </p>
        </field>
    </record>
</odoo>
