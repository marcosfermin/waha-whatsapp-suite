<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_server_action_form_waha" model="ir.ui.view">
        <field name="name">ir.actions.server.form.waha</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <group string="Send WhatsApp" invisible="state != 'waha_whatsapp'" colspan="2">
                    <field name="waha_session_id"/>
                    <field name="waha_template_id"/>
                    <field name="waha_partner_field"/>
                    <field name="waha_body" invisible="waha_template_id"
                           placeholder="Message sent to the record's contact. Use {{1}} variables only with a template."/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
