<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_waha_autoreply_list" model="ir.ui.view">
        <field name="name">waha.whatsapp.autoreply.list</field>
        <field name="model">waha.whatsapp.autoreply</field>
        <field name="arch" type="xml">
            <list string="Auto-reply Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="match_type"/>
                <field name="keyword"/>
                <field name="session_id"/>
                <field name="hit_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_waha_autoreply_form" model="ir.ui.view">
        <field name="name">waha.whatsapp.autoreply.form</field>
        <field name="model">waha.whatsapp.autoreply</field>
        <field name="arch" type="xml">
            <form string="Auto-reply Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Greeting bot"/></h1>
                    </div>
                    <group>
                        <group string="Trigger">
                            <field name="match_type"/>
                            <field name="keyword" invisible="match_type == 'any'"
                                   required="match_type != 'any'"
                                   placeholder="hello, hi, salam"/>
                            <field name="case_sensitive" invisible="match_type == 'any'"/>
                            <field name="session_id"/>
                            <field name="sequence"/>
                            <field name="stop_after_match"/>
                            <field name="active"/>
                        </group>
                        <group string="Business Hours">
                            <field name="only_business_hours"/>
                            <field name="hour_from" widget="float_time" invisible="not only_business_hours"/>
                            <field name="hour_to" widget="float_time" invisible="not only_business_hours"/>
                            <field name="hit_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Actions">
                        <group>
                            <field name="reply_template_id"/>
                            <field name="reply_body" placeholder="Reply sent to the contact"
                                   invisible="reply_template_id"/>
                            <field name="assign_user_id"/>
                        </group>
                        <group>
                            <field name="set_opt_out"/>
                            <field name="clear_opt_out"/>
                            <field name="create_lead"/>
                            <field name="create_ticket"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Reply Attachments">
                        <field name="reply_attachment_ids" widget="many2many_binary" nolabel="1"
                               colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_waha_autoreply" model="ir.actions.act_window">
        <field name="name">Auto-reply Rules</field>
        <field name="res_model">waha.whatsapp.autoreply</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first auto-reply rule</p>
            <p>Reply automatically to incoming WhatsApp messages based on keywords.</p>
        </field>
    </record>

</odoo>
