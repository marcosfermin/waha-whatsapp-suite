<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_waha_canned_reply_list" model="ir.ui.view">
        <field name="name">waha.whatsapp.canned.reply.list</field>
        <field name="model">waha.whatsapp.canned.reply</field>
        <field name="arch" type="xml">
            <list string="Canned Replies" editable="bottom">
                <field name="shortcut"/>
                <field name="name"/>
                <field name="body"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_waha_canned_reply" model="ir.actions.act_window">
        <field name="name">Canned Replies</field>
        <field name="res_model">waha.whatsapp.canned.reply</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first canned reply</p>
            <p>Quick replies you can insert in the chat composer with a shortcut.</p>
        </field>
    </record>

</odoo>
