<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- WhatsApp User Group -->
        <record model="ir.module.category" id="module_category_waha_whatsapp_suite">
            <field name="name">Waha Whatsapp</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_waha_whatsapp_user" model="res.groups">
            <field name="name">WhatsApp User</field>
            <field name="category_id" ref="module_category_waha_whatsapp_suite"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">View and send messages</field>
        </record>

        <!-- WhatsApp Manager Group -->
        <record id="group_waha_whatsapp_manager" model="res.groups">
            <field name="name">WhatsApp Manager</field>
            <field name="category_id" ref="module_category_waha_whatsapp_suite"/>
            <field name="implied_ids" eval="[(4, ref('group_waha_whatsapp_user'))]"/>
            <field name="comment">Manage templates and sessions</field>
        </record>

        <!-- Grant admin the manager group on install -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('group_waha_whatsapp_manager'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_waha_session_company" model="ir.rule">
            <field name="name">WAHA Session: multi-company</field>
            <field name="model_id" ref="model_waha_whatsapp_session"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_whatsapp_message_company" model="ir.rule">
            <field name="name">WhatsApp Message: multi-company</field>
            <field name="model_id" ref="model_waha_whatsapp_message"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_waha_campaign_company" model="ir.rule">
            <field name="name">WhatsApp Campaign: multi-company</field>
            <field name="model_id" ref="model_waha_whatsapp_campaign"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_waha_chat_thread_company" model="ir.rule">
            <field name="name">WhatsApp Conversation: multi-company</field>
            <field name="model_id" ref="model_waha_whatsapp_chat_thread"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>